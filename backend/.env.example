# PostgreSQL 数据库连接地址；必填，格式为 postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://modelmesh:modelmesh@127.0.0.1:5432/modelmesh

# Redis 连接地址；必填，格式为 redis://[:密码@]主机:端口/数据库编号
REDIS_URL=redis://127.0.0.1:6379/0

# Axum 服务监听地址；可选，默认值为 127.0.0.1:3000
MODELMESH_BIND_ADDRESS=127.0.0.1:3000

# 应用运行环境；可选，可选值为 development、test、production，默认值为 development；production 会写日志文件，其他环境只输出控制台
MODELMESH_ENVIRONMENT=development

# 日志级别过滤规则；可选，默认值为 info，支持 tracing EnvFilter 语法，例如 backend=debug,tower_http=info；生产环境不建议启用 trace
MODELMESH_LOG_FILTER=info

# 生产环境日志目录；可选，默认值为 logs；相对路径基于 backend 目录解析，生产环境必须确保进程具有写权限
MODELMESH_LOG_DIRECTORY=logs

# PostgreSQL 连接池的最大连接数；可选，必须为大于 0 的整数，默认值为 10
MODELMESH_DATABASE_MAX_CONNECTIONS=10

# PostgreSQL 连接池等待连接的超时秒数；可选，必须为大于 0 的整数，默认值为 5
MODELMESH_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Redis 连接池的最大连接数；可选，必须为大于 0 的整数，默认值为 10
MODELMESH_REDIS_MAX_CONNECTIONS=10

# Redis 连接池等待连接的超时秒数；可选，必须为大于 0 的整数，默认值为 5
MODELMESH_REDIS_WAIT_TIMEOUT_SECONDS=5

# 登录访问令牌在 Redis 中的有效秒数；可选，必须为大于 0 的整数，默认值为 86400（1 天）
MODELMESH_ACCESS_TOKEN_TTL_SECONDS=86400
