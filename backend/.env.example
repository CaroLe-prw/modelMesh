# PostgreSQL 数据库连接地址；必填，格式为 postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://modelmesh:modelmesh@127.0.0.1:5432/modelmesh

# Redis 连接地址；必填，格式为 redis://[:密码@]主机:端口/数据库编号
REDIS_URL=redis://127.0.0.1:6379/0

# Axum 服务监听地址；可选，默认值为 127.0.0.1:3000
MODELMESH_BIND_ADDRESS=127.0.0.1:3000

# 应用运行环境；可选，可选值为 development、test、production，默认值为 development；production 会写日志文件，其他环境只输出控制台
MODELMESH_ENVIRONMENT=development

# 日志级别过滤规则；可选，默认值为 info，支持 tracing EnvFilter 语法，例如 backend=debug,tower_http=info；生产环境不建议启用 trace
MODELMESH_LOG_FILTER=info

# 生产环境日志目录；可选，默认值为 logs；相对路径基于 backend 目录解析，生产环境必须确保进程具有写权限
MODELMESH_LOG_DIRECTORY=logs

# PostgreSQL API 请求连接池的最大连接数；可选，必须为大于 0 的整数，默认值为 10。models.dev 后台同步另用一个独立的单连接池，不占用此连接池。
MODELMESH_DATABASE_MAX_CONNECTIONS=10

# PostgreSQL 连接池等待连接的超时秒数；可选，必须为大于 0 的整数，默认值为 5
MODELMESH_DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

# Redis 连接池的最大连接数；可选，必须为大于 0 的整数，默认值为 10
MODELMESH_REDIS_MAX_CONNECTIONS=10

# Redis 连接池等待连接的超时秒数；可选，必须为大于 0 的整数，默认值为 5
MODELMESH_REDIS_WAIT_TIMEOUT_SECONDS=5

# 登录访问令牌在 Redis 中的有效秒数；可选，必须为大于 0 的整数，默认值为 86400（1 天）
MODELMESH_ACCESS_TOKEN_TTL_SECONDS=86400

# 上游渠道 API Key 的服务端加密主密钥；生产环境必填且至少 32 个字符，部署后必须稳定保存并限制读取权限，丢失或更换后已保存的渠道密钥将无法解密。开发环境未填写时会使用仅供本地调试的固定默认值。
MODELMESH_PROVIDER_CREDENTIAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# models.dev 模型目录定时同步间隔（小时）；可选，默认 24，必须为大于 0 的整数。每次后端启动会额外立即同步一次，生产环境建议定时间隔保持 24 小时，避免对公共数据源产生过多请求。
MODELMESH_MODELS_DEV_SYNC_INTERVAL_HOURS=24

# models.dev 目录地址；可选，默认使用官方 https://models.dev/api.json。仅在网络受限时改为可信的内部镜像，地址中不要携带密钥或其他敏感参数。
MODELMESH_MODELS_DEV_CATALOG_URL=https://models.dev/api.json

# models.dev TCP/TLS 建连超时秒数；可选，默认 10，必须为大于 0 的整数。
MODELMESH_MODELS_DEV_CONNECT_TIMEOUT_SECONDS=10

# models.dev 单次完整请求超时秒数；可选，默认 120，必须为大于 0 的整数。目录数据较大，生产环境不建议低于 60。
MODELMESH_MODELS_DEV_REQUEST_TIMEOUT_SECONDS=120

# 每轮 models.dev 同步最多请求次数；可选，默认 3，必须为大于 0 的整数。仅连接超时、请求超时、响应体中断、429 和 5xx 会重试。
MODELMESH_MODELS_DEV_MAX_ATTEMPTS=3

# models.dev 第一次重试等待秒数；可选，默认 2，必须为大于 0 的整数，后续重试按 2 倍递增。
MODELMESH_MODELS_DEV_RETRY_DELAY_SECONDS=2
